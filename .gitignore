# Dependencies
node_modules/

# Environment variables (never commit credentials)
.env
.env.local
.env.production

# Uploaded files (created at runtime — use backend/uploads/.gitkeep to track the folder)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
*.swo
