# Copy this file to .env and fill in your production values
# cp .env.example .env

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=uph_database

# Server port (Hostinger typically proxies 80/443 → 3000)
PORT=3000

# CORS — add your domain(s) separated by comma if needed
# Leave empty when frontend is served by the same Express process
ALLOWED_ORIGINS=
